# AI Provider configuration: ollama | groq | gemini
AI_PROVIDER=ollama

# Optional Free Cloud API Keys
# Get free Groq key at https://console.groq.com
GROQ_API_KEY=
# Get free Gemini key at https://aistudio.google.com
GEMINI_API_KEY=

# Ollama Defaults (100% Local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

PORT=3000
